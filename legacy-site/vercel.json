{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "ignoreCommand": "exit 1",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [{ "type": "host", "value": "mdify.devbehindyou.com" }],
      "destination": "https://llmiser.devbehindyou.com/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [{ "type": "host", "value": "mdify-app.vercel.app" }],
      "destination": "https://llmiser.devbehindyou.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/:path*",
      "missing": [
        { "type": "host", "value": "mdify.devbehindyou.com" },
        { "type": "host", "value": "mdify-app.vercel.app" }
      ],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ]
}
